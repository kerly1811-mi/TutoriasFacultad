generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMINISTRADOR
  DOCENTE
  ESTUDIANTE
  LABORATORISTA
}

enum TipoEspacio {
  AULA
  LABORATORIO
}

enum BloqueEspacio {
  BLOQUE_1
  BLOQUE_2
}

model Usuario {
  id_usr       Int        @id @default(autoincrement())
  cedula       String     @unique @db.VarChar(10)
  nombres      String     @db.VarChar(100)
  apellidos    String     @db.VarChar(100)
  correo       String     @unique @db.VarChar(100)
  password     String     // Requerido para autenticación JWT/Firebase Auth
  rol          RolUsuario

  // Relaciones
  matriculas           Matricula[]
  cursos_docente       Curso[]
  reservas_solicitadas Reserva[]      @relation("SolicitanteReserva")
  reservas_asignadas   Reserva[]      @relation("DocenteReserva")
  asistencias          Asistencia[]
  horarios_docente     HorarioClase[] @relation("DocenteHorario")
}

model Espacio {
  id_esp    Int           @id @default(autoincrement())
  nom_esp   String        @db.VarChar(100)
  tipo      TipoEspacio
  capacidad Int
  bloque    BloqueEspacio?
  piso      String?       @db.VarChar(5) // BLOQUE_1: "1".."3" | BLOQUE_2: "C".."J"
  estado    String        @default("DISPONIBLE") @db.VarChar(20) // DISPONIBLE | MANTENIMIENTO

  reservas Reserva[]
  horarios HorarioClase[]
}

// Horario semanal de clases regulares. Se carga una vez por ciclo; se repite
// cada semana. Es lo que, junto con las reservas, define cuándo un aula está libre.
model HorarioClase {
  id_hor       Int      @id @default(autoincrement())
  id_esp       Int
  nombre_curso String   @db.VarChar(150)
  id_doc       Int?
  dia_semana   String   @db.VarChar(10) // LUNES, MARTES, MIERCOLES, JUEVES, VIERNES, SABADO, DOMINGO
  hora_ini     String   @db.VarChar(5) // "HH:MM"
  hora_fin     String   @db.VarChar(5) // "HH:MM"

  espacio Espacio  @relation(fields: [id_esp], references: [id_esp])
  docente Usuario? @relation("DocenteHorario", fields: [id_doc], references: [id_usr])
}

// Curso dictado por un docente (ej. "Física B"). Reemplaza la cadena
// Carrera -> Nivel -> Materia -> Paralelo, que no se usaba.
model Curso {
  id_cur  Int    @id @default(autoincrement())
  nom_cur String @db.VarChar(150)
  id_doc  Int

  docente    Usuario     @relation(fields: [id_doc], references: [id_usr])
  matriculas Matricula[]
  reservas   Reserva[]
}

// Matrícula de un estudiante en un curso (relación muchos-a-muchos).
// Determina qué tutorías (reservas) le aparecen a cada estudiante.
model Matricula {
  id_matricula Int @id @default(autoincrement())
  id_est       Int
  id_cur       Int

  estudiante Usuario @relation(fields: [id_est], references: [id_usr])
  curso      Curso   @relation(fields: [id_cur], references: [id_cur])

  @@unique([id_est, id_cur])
}

model Reserva {
  id_rev             Int      @id @default(autoincrement())
  id_esp             Int
  id_usr_solicitante Int
  id_doc_asignado    Int? // Se conserva por compatibilidad; ya no se usa (el docente que reserva es el tutor)
  id_cur             Int? // Curso al que pertenece esta tutoría (opcional). Filtra qué ven los estudiantes matriculados.
  fecha              DateTime @db.Date
  hor_ini            DateTime @db.Time
  hor_fin            DateTime @db.Time
  estado             String   @default("RESERVADA") @db.VarChar(20) // RESERVADA | CANCELADA
  motivo             String?  @db.Text
  motivo_cancelacion String?  @db.Text
  qr_token           String?  @unique @db.VarChar(255)

  espacio          Espacio @relation(fields: [id_esp], references: [id_esp])
  solicitante      Usuario @relation("SolicitanteReserva", fields: [id_usr_solicitante], references: [id_usr])
  docente_asignado Usuario? @relation("DocenteReserva", fields: [id_doc_asignado], references: [id_usr])
  curso            Curso?  @relation(fields: [id_cur], references: [id_cur])

  asistencias Asistencia[]
  documentos  Documento[]

  @@index([id_esp, fecha])
}

model Asistencia {
  id_asi        Int      @id @default(autoincrement())
  id_rev        Int
  id_est        Int
  hora_registro DateTime @default(now())
  validado_qr   Boolean  @default(true)

  reserva    Reserva @relation(fields: [id_rev], references: [id_rev])
  estudiante Usuario @relation(fields: [id_est], references: [id_usr])

  @@unique([id_rev, id_est])
}

model Documento {
  id_docu      Int      @id @default(autoincrement())
  id_rev       Int
  url_archivo  String   @db.Text
  nom_archivo  String   @db.VarChar(255)
  fecha_subida DateTime @default(now())

  reserva Reserva @relation(fields: [id_rev], references: [id_rev])
}
